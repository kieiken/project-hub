(version 1)
(allow default)
(deny network*)
; FB-only ephemeral proxy. Other operations retain their existing profiles.
; IPv4 loopback only; known local service ports are explicitly denied below.
(allow network-outbound (remote tcp "*:443") (remote udp "*:53") (remote tcp "*:53"))
(allow network-outbound (literal "/private/var/run/mDNSResponder"))
(allow network-bind (local tcp4 "localhost:*"))
(allow network-inbound (local tcp4 "localhost:*"))
(allow network-outbound (remote tcp4 "localhost:*"))
(deny network-bind network-inbound (local tcp4 "localhost:53"))
(deny network-outbound (remote tcp4 "localhost:53"))
(deny network-bind network-inbound (local tcp4 "localhost:3210"))
(deny network-outbound (remote tcp4 "localhost:3210"))
(deny network-bind network-inbound (local tcp4 "localhost:3211"))
(deny network-outbound (remote tcp4 "localhost:3211"))
(deny network-bind network-inbound (local tcp4 "localhost:4545"))
(deny network-outbound (remote tcp4 "localhost:4545"))
(deny network-bind network-inbound (local tcp4 "localhost:4786"))
(deny network-outbound (remote tcp4 "localhost:4786"))
(deny network-bind network-inbound (local tcp4 "localhost:5000"))
(deny network-outbound (remote tcp4 "localhost:5000"))
(deny network-bind network-inbound (local tcp4 "localhost:5678"))
(deny network-outbound (remote tcp4 "localhost:5678"))
(deny network-bind network-inbound (local tcp4 "localhost:5679"))
(deny network-outbound (remote tcp4 "localhost:5679"))
(deny network-bind network-inbound (local tcp4 "localhost:5695"))
(deny network-outbound (remote tcp4 "localhost:5695"))
(deny network-bind network-inbound (local tcp4 "localhost:6463"))
(deny network-outbound (remote tcp4 "localhost:6463"))
(deny network-bind network-inbound (local tcp4 "localhost:7000"))
(deny network-outbound (remote tcp4 "localhost:7000"))
(deny network-bind network-inbound (local tcp4 "localhost:8769"))
(deny network-outbound (remote tcp4 "localhost:8769"))
(deny network-bind network-inbound (local tcp4 "localhost:8790"))
(deny network-outbound (remote tcp4 "localhost:8790"))
(deny network-bind network-inbound (local tcp4 "localhost:8791"))
(deny network-outbound (remote tcp4 "localhost:8791"))
(deny network-bind network-inbound (local tcp4 "localhost:8796"))
(deny network-outbound (remote tcp4 "localhost:8796"))
(deny network-bind network-inbound (local tcp4 "localhost:9333"))
(deny network-outbound (remote tcp4 "localhost:9333"))
(deny network-bind network-inbound (local tcp4 "localhost:18789"))
(deny network-outbound (remote tcp4 "localhost:18789"))
(deny network-bind network-inbound (local tcp4 "localhost:20241"))
(deny network-outbound (remote tcp4 "localhost:20241"))
(deny network-bind network-inbound (local tcp4 "localhost:20242"))
(deny network-outbound (remote tcp4 "localhost:20242"))
(deny network-bind network-inbound (local tcp4 "localhost:49152"))
(deny network-outbound (remote tcp4 "localhost:49152"))
(deny network-bind network-inbound (local tcp4 "localhost:49411"))
(deny network-outbound (remote tcp4 "localhost:49411"))
(deny network-bind network-inbound (local tcp4 "localhost:53738"))
(deny network-outbound (remote tcp4 "localhost:53738"))
(deny network-bind network-inbound (local tcp4 "localhost:53764"))
(deny network-outbound (remote tcp4 "localhost:53764"))
(deny network-bind network-inbound (local tcp4 "localhost:53800"))
(deny network-outbound (remote tcp4 "localhost:53800"))
(deny network-bind network-inbound (local tcp4 "localhost:53816"))
(deny network-outbound (remote tcp4 "localhost:53816"))
(deny network-bind network-inbound (local tcp4 "localhost:54258"))
(deny network-outbound (remote tcp4 "localhost:54258"))
(deny network-bind network-inbound (local tcp4 "localhost:64517"))
(deny network-outbound (remote tcp4 "localhost:64517"))
(deny file-read-data
  (require-all (subpath "/Users") (require-not (vnode-type DIRECTORY))
    (require-not (require-any
      (subpath (string-append (param "bundle") "/.venv"))
      (subpath (string-append (param "bundle") "/inputs"))
      (subpath (param "bridge"))
      (subpath (param "project"))
      (literal (string-append (param "private") "/workspace-muse/metamuse.toml"))
      (literal (string-append (param "private") "/.registration.lock"))
      (subpath (string-append (param "private") "/auth"))
      (subpath (param "taskroot"))))))
(deny file-write*
  (require-not (require-any
    (literal (param "private"))
    (literal (string-append (param "private") "/projects"))
    (literal (string-append (param "private") "/.registration.lock"))
    (literal (param "taskparent"))
    (subpath (param "taskroot")) (literal "/dev/null") (literal "/dev/tty"))))
(deny process-exec
  (require-not (require-any (subpath (string-append (param "bundle") "/.venv"))
    (subpath "/opt/homebrew/Cellar/python@3.12")
    (subpath (string-append (param "taskroot") "/extras-venv/bin"))
    (subpath (string-append (param "taskroot") "/extras-browser-venv"))
    (subpath (string-append (param "taskroot") "/extras-browser"))
    (subpath (string-append (param "taskroot") "/facebook-browser-cache"))
    (literal "/bin/sh") (literal "/usr/bin/env"))))

(deny file-read-data (subpath (string-append (param "taskroot") "/credential-intake")))
